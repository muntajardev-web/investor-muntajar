  @@index([senderId])
  @@index([recipientId])
  @@index([applicationId])
  @@index([status])
  @@index([deletedAt])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("messages")
}

