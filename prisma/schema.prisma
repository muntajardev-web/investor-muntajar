model JobListing {
  id              String       @id @default(uuid()) @db.Uuid
  employerId      String?      @map("employer_id") @db.Uuid
  company         String
  title           String
  country         String
  city            String?
  salaryMin       Decimal?     @map("salary_min") @db.Decimal(12, 2)
  salaryMax       Decimal?     @map("salary_max") @db.Decimal(12, 2)
  salaryCurrency  String       @default("USD") @map("salary_currency") @db.Char(3)
  visaSponsorship Boolean      @default(false) @map("visa_sponsorship")
  requirements    String[]     @default([])
  skills          String[]     @default([])
  jobType         PreferredJobType @default(FULL_TIME) @map("job_type")
  description     String?      @db.Text
  experienceYears Int?         @map("experience_years")
  educationLevel  String?      @map("education_level")
  languages       String[]     @default([])
  /** OpenAI/local embedding vector stored as JSON for similarity search */
  embedding       Json?
  embeddingModel  String?      @map("embedding_model")
  embeddedAt      DateTime?    @map("embedded_at")
  metadata        Json?
  status          RecordStatus @default(ACTIVE)
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  employer      Employer?               @relation(fields: [employerId], references: [id], onDelete: SetNull)
