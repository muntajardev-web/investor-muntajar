enum AiUserApproval {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════════════
// USERS & ROLES
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id          String       @id @default(uuid()) @db.Uuid
  clerkId     String       @unique @map("clerk_id")
  email       String       @unique
  name        String?
  phone       String?
  avatarUrl   String?      @map("avatar_url")
  role        UserRole     @default(STUDENT)
  serviceType ServiceType? @map("service_type")
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  studentProfile         StudentProfile?
  workerProfile          WorkerProfile?
  adminUser              AdminUser?
  agent                  Agent?
  applications           Application[]
  documents              Document[]
  recommendationHistory  RecommendationHistory[]
  savedUniversities      SavedUniversity[]
  notifications          Notification[]
  sentMessages           Message[]               @relation("SentMessages")
  receivedMessages       Message[]               @relation("ReceivedMessages")
  payments               Payment[]
  invoices               Invoice[]
  consultationBookings   ConsultationBooking[]   @relation("StudentConsultations")
  auditLogs              AuditLog[]
  aiAuditLogs            AiAuditLog[]
  verifiedDocuments      DocumentVerification[]  @relation("DocumentVerifier")
  employmentDocuments    EmploymentDocument[]
  jobMatches             JobMatch[]
  employmentApplications EmploymentApplication[]
  employmentActivities   EmploymentActivity[]
  employmentInterviews   EmploymentInterview[]
  careerAdviceMessages   CareerAdviceMessage[]
  coverLetterVersions    CoverLetterVersion[]
  savedJobs              SavedJob[]
  supportTickets         SupportTicket[]         @relation("TicketRequester")
  assignedTickets        SupportTicket[]         @relation("TicketAssignee")

  @@index([email])
  @@index([role])
  @@index([serviceType])
  @@index([status])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@map("users")
}

model StudentProfile {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @map("user_id") @db.Uuid
  gpa              Float?
  gpaScale         Float?       @default(4.0) @map("gpa_scale")
  board            BoardType?
  nationality      String?
  dateOfBirth      DateTime?    @map("date_of_birth") @db.Date
  targetCountries  String[]     @map("target_countries")
  budget           Decimal?     @db.Decimal(12, 2)
  budgetCurrency   String       @default("USD") @map("budget_currency") @db.Char(3)
  degreeLevel      DegreeLevel  @map("degree_level")
  preferredCourses String[]     @map("preferred_courses")
  ieltsOverall     Float?       @map("ielts_overall")
  ieltsReading     Float?       @map("ielts_reading")
  ieltsWriting     Float?       @map("ielts_writing")
  ieltsListening   Float?       @map("ielts_listening")
  ieltsSpeaking    Float?       @map("ielts_speaking")
  toeflScore       Int?         @map("toefl_score")
  workExperience   Int?         @map("work_experience_years")
  bio              String?      @db.Text
  otherPreferences Json?        @map("other_preferences")
  isComplete       Boolean      @default(false) @map("is_complete")
  status           RecordStatus @default(ACTIVE)
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([degreeLevel])
  @@index([status])
  @@index([deletedAt])
  @@index([targetCountries])
  @@map("student_profiles")
}

model AdminUser {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @unique @map("user_id") @db.Uuid
  department  String?
  permissions Json         @default("[]")
  title       String?
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([deletedAt])
  @@map("admin_users")
}

model Agent {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  agencyName     String       @map("agency_name")
  licenseNumber  String?      @map("license_number")
  specialties    String[]     @default([])
  countries      String[]     @default([])
  bio            String?      @db.Text
  rating         Float?       @default(0)
  totalStudents  Int          @default(0) @map("total_students")
  status         RecordStatus @default(ACTIVE)
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications           Application[]
  consultationBookings   ConsultationBooking[]   @relation("AgentConsultations")

  @@index([status])
  @@index([deletedAt])
  @@index([agencyName])
  @@map("agents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// GEOGRAPHY & REFERENCE DATA
// ═══════════════════════════════════════════════════════════════════════════════

model Country {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  code            String       @unique @db.Char(2)
  code3           String       @unique @map("code_3") @db.Char(3)
  currency        String       @default("USD") @db.Char(3)
  livingCost      Decimal?     @map("living_cost") @db.Decimal(12, 2)
  safetyIndex     Float?       @map("safety_index")
  postStudyWork   String?      @map("post_study_work")
  ieltsRequired   Float?       @map("ielts_required")
  flagUrl         String?      @map("flag_url")
  metadata        Json?
  status          RecordStatus @default(ACTIVE)
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  universities University[]
  visaRules    VisaRule[]

  @@index([name])
  @@index([status])
  @@index([deletedAt])
  @@map("countries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// UNIVERSITIES & PROGRAMS
// ═══════════════════════════════════════════════════════════════════════════════

model University {
  id             String         @id @default(uuid()) @db.Uuid
  countryId      String         @map("country_id") @db.Uuid
  slug           String         @unique
  name           String
  city           String?
  type           UniversityType @default(PUBLIC)
  website        String?
  logoUrl        String?        @map("logo_url")
  description    String?        @db.Text
  acceptanceRate Float?         @map("acceptance_rate")
  foundedYear    Int?           @map("founded_year")
  metadata       Json?
  status         RecordStatus   @default(ACTIVE)
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  country               Country                @relation(fields: [countryId], references: [id])
  partnerUniversity     PartnerUniversity?
  programs              Program[]
  scholarships          Scholarship[]
  rankings              UniversityRanking[]
  deadlines             UniversityDeadline[]
  applications          Application[]
  recommendationHistory RecommendationHistory[]
  savedUniversities     SavedUniversity[]

  @@index([countryId])
  @@index([name])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
  @@index([countryId, status])
  @@map("universities")
}

model PartnerUniversity {
  id              String          @id @default(uuid()) @db.Uuid
  universityId    String          @unique @map("university_id") @db.Uuid
  tier            PartnershipTier @default(BRONZE)
  commissionRate  Decimal?        @map("commission_rate") @db.Decimal(5, 2)
  contractStart   DateTime?       @map("contract_start") @db.Date
  contractEnd     DateTime?       @map("contract_end") @db.Date
  contactName     String?         @map("contact_name")
  contactEmail    String?         @map("contact_email")
  contactPhone    String?         @map("contact_phone")
  notes           String?         @db.Text
  status          RecordStatus    @default(ACTIVE)
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([status])
  @@index([deletedAt])
  @@map("partner_universities")
}

model Program {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @map("university_id") @db.Uuid
  name         String
  slug         String
  degreeLevel  DegreeLevel  @map("degree_level")
  field        String?
  duration     Int?
  durationUnit String       @default("months") @map("duration_unit")
  tuitionFee   Decimal?     @map("tuition_fee") @db.Decimal(12, 2)
  currency     String       @default("USD") @db.Char(3)
  language     String       @default("English")
  description  String?      @db.Text
  metadata     Json?
  status       RecordStatus @default(ACTIVE)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  university            University             @relation(fields: [universityId], references: [id], onDelete: Cascade)
  intakes               Intake[]
  requirements          Requirement[]
  requiredDocuments     ProgramRequiredDocument[]
  scholarships          Scholarship[]
  deadlines             UniversityDeadline[]
  applications          Application[]
  recommendationHistory RecommendationHistory[]

  @@unique([universityId, slug])
  @@index([universityId])
  @@index([degreeLevel])
  @@index([field])
  @@index([status])
  @@index([deletedAt])
  @@index([tuitionFee])
  @@map("programs")
}

model Intake {
  id                  String       @id @default(uuid()) @db.Uuid
  programId           String       @map("program_id") @db.Uuid
  name                String
  startDate           DateTime     @map("start_date") @db.Date
  applicationDeadline DateTime?    @map("application_deadline")
  seats               Int?
  seatsAvailable      Int?         @map("seats_available")
  status              RecordStatus @default(ACTIVE)
  deletedAt           DateTime?    @map("deleted_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  program       Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  applications  Application[]
  deadlines     UniversityDeadline[]

  @@index([programId])
  @@index([startDate])
  @@index([applicationDeadline])
  @@index([status])
  @@index([deletedAt])
  @@map("intakes")
}

model Requirement {
  id          String          @id @default(uuid()) @db.Uuid
  programId   String          @map("program_id") @db.Uuid
  type        RequirementType
  label       String
  minValue    String?         @map("min_value")
  maxValue    String?         @map("max_value")
  description String?         @db.Text
  isMandatory Boolean         @default(true) @map("is_mandatory")
  status      RecordStatus    @default(ACTIVE)
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("requirements")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DOCUMENT CATALOG
// ═══════════════════════════════════════════════════════════════════════════════

model DocumentType {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?      @db.Text
  category    String?
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  programRequiredDocuments ProgramRequiredDocument[]
  documents                Document[]

  @@index([category])
  @@index([status])
  @@index([deletedAt])
  @@map("document_types")
}

model ProgramRequiredDocument {
  id             String       @id @default(uuid()) @db.Uuid
  programId      String       @map("program_id") @db.Uuid
  documentTypeId String       @map("document_type_id") @db.Uuid
  isMandatory    Boolean      @default(true) @map("is_mandatory")
  notes          String?
  status         RecordStatus @default(ACTIVE)
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  @@unique([programId, documentTypeId])
  @@index([programId])
  @@index([documentTypeId])
  @@index([status])
  @@index([deletedAt])
  @@map("program_required_documents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// SCHOLARSHIPS · VISA · RANKINGS · DEADLINES
// ═══════════════════════════════════════════════════════════════════════════════

model Scholarship {
  id           String          @id @default(uuid()) @db.Uuid
  universityId String?         @map("university_id") @db.Uuid
  programId    String?         @map("program_id") @db.Uuid
  name         String
  type         ScholarshipType
  amount       Decimal?        @db.Decimal(12, 2)
  currency     String          @default("USD") @db.Char(3)
  coverage     String?
  eligibility  Json?
  deadline     DateTime?
  link         String?
  status       RecordStatus    @default(ACTIVE)
  deletedAt    DateTime?       @map("deleted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  program    Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([programId])
  @@index([type])
  @@index([deadline])
  @@index([status])
  @@index([deletedAt])
  @@map("scholarships")
}

model VisaRule {
  id              String       @id @default(uuid()) @db.Uuid
  countryId       String       @map("country_id") @db.Uuid
  visaType        VisaType     @map("visa_type")
  title           String
  description     String?      @db.Text
  requirements    Json?
  processingDays  Int?         @map("processing_days")
  successRate     Float?       @map("success_rate")
  fees            Decimal?     @db.Decimal(12, 2)
  feesCurrency    String?      @map("fees_currency") @db.Char(3)
  validityPeriod  String?      @map("validity_period")
  status          RecordStatus @default(ACTIVE)
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([visaType])
  @@index([status])
  @@index([deletedAt])
  @@map("visa_rules")
}

model UniversityRanking {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @map("university_id") @db.Uuid
  rankingBody  String       @map("ranking_body")
  rank         Int
  year         Int
  score        Float?
  subject      String?
  status       RecordStatus @default(ACTIVE)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, rankingBody, year, subject])
  @@index([universityId])
  @@index([rankingBody, year])
  @@index([rank])
  @@index([status])
  @@index([deletedAt])
  @@map("university_rankings")
}

model UniversityDeadline {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @map("university_id") @db.Uuid
  programId    String?      @map("program_id") @db.Uuid
  intakeId     String?      @map("intake_id") @db.Uuid
  type         DeadlineType
  title        String
  deadline     DateTime
  description  String?      @db.Text
  status       RecordStatus @default(ACTIVE)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  program    Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  intake     Intake?    @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  @@index([universityId])
  @@index([programId])
  @@index([intakeId])
  @@index([deadline])
  @@index([type])
  @@index([status])
  @@index([deletedAt])
  @@map("university_deadlines")
}

// ═══════════════════════════════════════════════════════════════════════════════
// APPLICATIONS & TIMELINE
// ═══════════════════════════════════════════════════════════════════════════════

model Application {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  universityId String            @map("university_id") @db.Uuid
  programId    String            @map("program_id") @db.Uuid
  intakeId     String?           @map("intake_id") @db.Uuid
  agentId      String?           @map("agent_id") @db.Uuid
  status       ApplicationStatus @default(DRAFT)
  notes        String?           @db.Text
  submittedAt  DateTime?         @map("submitted_at")
  decidedAt    DateTime?         @map("decided_at")
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])
  program    Program    @relation(fields: [programId], references: [id])
  intake     Intake?    @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  agent      Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  timeline     ApplicationTimeline[]
