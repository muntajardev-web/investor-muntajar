  WORK
  TOURIST
  TRANSIT
  DEPENDENT
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_REQUESTED
  INTERVIEW_SCHEDULED
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
