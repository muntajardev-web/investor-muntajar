// Muntajar — Production PostgreSQL Schema (Neon)
// Global Mobility Platform · Normalized · UUID · Soft Delete · Indexed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum RecordStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  STUDENT
  AGENT
  ADMIN
}

enum ServiceType {
  STUDY
  EMPLOYMENT
}

enum PreferredJobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  SEASONAL
}

enum EmploymentApplicationStatus {
  DRAFT
  PREPARING
  WAITING_PAYMENT
  SUBMITTED
  EMPLOYER_REVIEWING
  INTERVIEW
  MEDICAL
  VISA_PROCESSING
  OFFER_LETTER
  ACCEPTED
  REJECTED
  COMPLETED
}

enum EmploymentDocumentKind {
  PASSPORT
  NATIONAL_ID
  SSC
  HSC
  DIPLOMA
  DEGREE
  EXPERIENCE_LETTER
  TRAINING_CERTIFICATE
  TRADE_LICENSE
  POLICE_CLEARANCE
  MEDICAL_REPORT
  MEDICAL_CERTIFICATE
  BIRTH_CERTIFICATE
  MARRIAGE_CERTIFICATE
  DRIVING_LICENSE
  CV
  LANGUAGE_CERTIFICATE
  OTHER
}

enum DocumentProcessingStatus {
  PENDING_UPLOAD
  UPLOADED
  SCANNING
  SCAN_FAILED
  SCAN_CLEAN
  OCR_QUEUED
  OCR_PROCESSING
  OCR_COMPLETE
  OCR_FAILED
  AI_QUEUED
  AI_EXTRACTING
  AI_COMPLETE
  AI_FAILED
  AWAITING_REVIEW
  EMBEDDING_QUEUED
  EMBEDDING
  EMBEDDING_COMPLETE
  PROFILE_UPDATING
  COMPLETED
  FAILED
}

enum ExtractionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DegreeLevel {
  FOUNDATION
  BACHELOR
  MASTER
  PHD
  DIPLOMA
  CERTIFICATE
}

enum BoardType {
  HSC
  A_LEVEL
  IB
  CBSE
  WAEC
  OTHER
}

enum UniversityType {
