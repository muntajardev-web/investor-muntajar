  SILVER
  GOLD
  PLATINUM
}

enum RequirementType {
  GPA
  SSC_GPA
  HSC_GPA
  IELTS
  TOEFL
  DUOLINGO
  SAT
  GRE
  GMAT
  WORK_EXPERIENCE
  PORTFOLIO
  INTERVIEW
  OTHER
