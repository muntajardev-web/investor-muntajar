  NEED_BASED
  COUNTRY_SPECIFIC
  UNIVERSITY
  GOVERNMENT
  EXTERNAL
}

enum EmployerKind {
  EMPLOYER
  COMPANY
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VisaType {
