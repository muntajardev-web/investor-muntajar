  notes         String?      @db.Text
  status        RecordStatus @default(ACTIVE)
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  application EmploymentApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobListing  JobListing?            @relation(fields: [jobListingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([scheduledAt])
  @@index([status])
  @@index([deletedAt])
  @@map("employment_interviews")
}

model CareerAdviceMessage {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      String
  content   String       @db.Text
  status    RecordStatus @default(ACTIVE)
  deletedAt DateTime?    @map("deleted_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([deletedAt])
  @@map("career_advice_messages")
}

model CoverLetterVersion {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  version      Int
  template     String
  language     String       @default("en")
  jobTitle     String?      @map("job_title")
  company      String?
  country      String?
  jobListingId String?      @map("job_listing_id") @db.Uuid
  content      String       @db.Text
  userEdited   Boolean      @default(false) @map("user_edited")
  isActive     Boolean      @default(true) @map("is_active")
  status       RecordStatus @default(ACTIVE)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, version(sort: Desc)])
  @@index([userId, isActive])
  @@index([template])
  @@index([status])
  @@index([deletedAt])
  @@map("cover_letter_versions")
}

model SavedJob {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  jobListingId String       @map("job_listing_id") @db.Uuid
  notes        String?      @db.Text
  status       RecordStatus @default(ACTIVE)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListing JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobListingId])
  @@index([userId])
  @@index([jobListingId])
  @@index([status])
  @@index([deletedAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_jobs")
}

model Employer {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  kind        EmployerKind @default(COMPANY)
  country     String?
  city        String?
  website     String?
  email       String?
  phone       String?
  industry    String?
  description String?      @db.Text
  logoUrl     String?      @map("logo_url")
  metadata    Json?
  status      RecordStatus @default(ACTIVE)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  jobs JobListing[]

  @@index([name])
  @@index([kind])
  @@index([country])
  @@index([status])
  @@index([deletedAt])
  @@map("employers")
}

model VisaProgram {
  id             String       @id @default(uuid()) @db.Uuid
  countryCode    String       @map("country_code") @db.Char(2)
  countryName    String       @map("country_name")
  name           String
  description    String?      @db.Text
  requirements   Json?
  processingDays Int?         @map("processing_days")
  successRate    Float?       @map("success_rate")
  fees           Decimal?     @db.Decimal(12, 2)
  feesCurrency   String?      @map("fees_currency") @db.Char(3)
  validityPeriod String?      @map("validity_period")
  visaSponsorship Boolean     @default(true) @map("visa_sponsorship")
  metadata       Json?
  status         RecordStatus @default(ACTIVE)
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([countryCode])
  @@index([name])
  @@index([status])
  @@index([deletedAt])
  @@map("visa_programs")
}

model SupportTicket {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  assignedToId String?               @map("assigned_to_id") @db.Uuid
  subject      String
  body         String                @db.Text
  category     String                @default("employment")
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  resolution   String?               @db.Text
  metadata     Json?
  resolvedAt   DateTime?             @map("resolved_at")
  deletedAt    DateTime?             @map("deleted_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user       User  @relation("TicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assignedToId])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("support_tickets")
}
